rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Uploads de redes sociales del usuario ──────────────────────────────
    match /social_media_uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /social_media_templates/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Logos corporativos del usuario ────────────────────────────────────
    match /logos/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Perfiles y avatars ────────────────────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Admin: Generador de Muestras para Prospectos ──────────────────────
    // Imágenes base y logos subidos en el generador de demos comerciales.
    match /admin_demos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // ── Muestras de Video Prompts (showcase de referencia) ───────────────
    match /flow_showcase/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Videos generados (image-to-video, Remotion, etc.) ────────────────
    match /generated_videos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // ── Blog: imágenes de portada generadas por agentes ──────────────────
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Posts: imágenes y videos generados por usuario ────────────────────
    match /posts/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Audios generados (ElevenLabs TTS voiceovers) ─────────────────────
    match /audio/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Catálogo de productos del usuario ────────────────────────────────
    match /catalogo/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
